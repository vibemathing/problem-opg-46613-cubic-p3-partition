{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-mathing.local/schema/obligation-graph.v1.json",
  "title": "Vibe Mathing Immutable Obligation DAG",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "problem_id",
    "attempt_id",
    "route_id",
    "problem_contract_sha256",
    "root_obligation_id",
    "obligations",
    "created_at",
    "supersedes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "graph_id": {"type": "string", "pattern": "^graph:[a-z0-9][a-z0-9.-]*$"},
    "problem_id": {"type": "string", "pattern": "^problem:[a-z0-9][a-z0-9.-]*$"},
    "attempt_id": {"type": "string", "pattern": "^attempt:[a-z0-9][a-z0-9.-]*$"},
    "route_id": {"type": "string", "pattern": "^route:[a-z0-9][a-z0-9.-]*$"},
    "problem_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "root_obligation_id": {"type": "string", "pattern": "^obligation:[a-z0-9][a-z0-9.-]*$"},
    "obligations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/obligation"}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "supersedes": {
      "type": ["string", "null"],
      "pattern": "^graph:[a-z0-9][a-z0-9.-]*$"
    }
  },
  "$defs": {
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "kind",
        "statement",
        "statement_sha256",
        "dependencies",
        "acceptance",
        "source_refs"
      ],
      "properties": {
        "obligation_id": {"type": "string", "pattern": "^obligation:[a-z0-9][a-z0-9.-]*$"},
        "kind": {
          "enum": ["root_claim", "definition", "lemma", "theorem", "computation", "counterexample_target"]
        },
        "statement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "language", "formal_declaration"],
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "language": {"type": "string", "minLength": 2},
            "formal_declaration": {"type": ["string", "null"], "minLength": 1}
          }
        },
        "statement_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^obligation:[a-z0-9][a-z0-9.-]*$"}
        },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_capabilities", "allowed_candidate_kinds"],
          "properties": {
            "required_capabilities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
            },
            "allowed_candidate_kinds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["proof", "counterexample", "formalization", "computation"]}
            }
          }
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
