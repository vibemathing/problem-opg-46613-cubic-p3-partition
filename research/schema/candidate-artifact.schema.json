{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-mathing.local/schema/candidate-artifact.v1.json",
  "title": "Vibe Mathing Immutable Candidate Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "graph_id",
    "obligation_id",
    "problem_id",
    "attempt_id",
    "statement_sha256",
    "kind",
    "generator",
    "artifact",
    "source_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidate_id": {"type": "string", "pattern": "^candidate:[a-z0-9][a-z0-9.-]*$"},
    "graph_id": {"type": "string", "pattern": "^graph:[a-z0-9][a-z0-9.-]*$"},
    "obligation_id": {"type": "string", "pattern": "^obligation:[a-z0-9][a-z0-9.-]*$"},
    "problem_id": {"type": "string", "pattern": "^problem:[a-z0-9][a-z0-9.-]*$"},
    "attempt_id": {"type": "string", "pattern": "^attempt:[a-z0-9][a-z0-9.-]*$"},
    "statement_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "kind": {"enum": ["proof", "counterexample", "formalization", "computation"]},
    "generator": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "sha256", "media_type"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "media_type": {"type": "string", "minLength": 1}
      }
    },
    "source_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
