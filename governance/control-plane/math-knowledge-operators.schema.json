{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-mathing.local/schema/math-knowledge-operators.v1.json",
  "title": "Vibe Mathing Reuse-first Mathematical Operator Library",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operators"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "operators": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/operator"}
    }
  },
  "$defs": {
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_id", "owner_skill", "purpose", "input_kinds", "output_kind",
        "external_effect", "evidence_ceiling", "requires", "fail_closed_on"
      ],
      "properties": {
        "operator_id": {"type": "string", "pattern": "^op:[a-z][a-z0-9.-]*$"},
        "owner_skill": {
          "enum": ["math-discovery", "math-derivation", "math-computation", "math-proof", "math-formalization"]
        },
        "purpose": {"type": "string", "minLength": 1},
        "input_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "output_kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "external_effect": {"enum": ["none", "read_local", "read_network", "bounded_candidate_build", "bounded_candidate_compute"]},
        "evidence_ceiling": {"enum": ["discovery_only", "candidate_only", "computation_evidence", "verifier_receipt"]},
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "fail_closed_on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    }
  }
}
