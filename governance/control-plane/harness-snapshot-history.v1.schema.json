{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibemathing.example/schemas/harness-snapshot-history.v1.schema.json",
  "title": "Harness Snapshot History",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "repository_identity", "entries"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "repository_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_id", "node_id", "default_branch", "visibility"],
      "properties": {
        "database_id": {"type": ["integer", "null"], "minimum": 1},
        "node_id": {"type": ["string", "null"], "minLength": 1},
        "default_branch": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["private", "public"]}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "harness_snapshot_sha256",
          "harness_version",
          "tree_sha256",
          "source_manifest_sha256",
          "importer_policy_sha256"
        ],
        "properties": {
          "harness_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "harness_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "importer_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
