{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-mathing.local/schema/container-skill-source-lock.v1.json",
  "title": "Compute-container Skill source and Web adaptation lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lock_id", "scope", "digest_algorithm", "excluded_skill_ids", "skills"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "lock_id": {"const": "container-skill-lock:web-problem-repository-v1"},
    "scope": {"const": "compute_container_skills_for_web_problem_repositories"},
    "digest_algorithm": {"const": "sha256-canonical-json-sorted-path-bytes-file-sha256-v1"},
    "excluded_skill_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/skill"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "files", "bytes", "tree_sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "files": {"type": "integer", "minimum": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "tree_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "web_status", "source_identity", "source_status", "source_snapshot", "distributed_snapshot", "adaptations", "evidence_ceiling"],
      "properties": {
        "skill_id": {"enum": ["solve", "math-toolchain"]},
        "web_status": {"enum": ["active", "constrained"]},
        "source_identity": {"type": "string", "minLength": 1},
        "source_status": {"enum": ["content_locked_pending_source_commit", "container_observed_content_locked"]},
        "source_snapshot": {"$ref": "#/$defs/snapshot"},
        "source_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "content_manifest", "synchronized_copies", "strict_validation", "limitations"],
          "properties": {
            "kind": {"const": "owner_install_sync_receipt"},
            "content_manifest": {"$ref": "#/$defs/digest"},
            "synchronized_copies": {"type": "integer", "minimum": 1},
            "strict_validation": {"const": "PASS"},
            "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "distributed_snapshot": {"$ref": "#/$defs/snapshot"},
        "adaptations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_ceiling": {"const": "candidate_only"},
        "operator_library": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_entries", "derived_entries", "entries"],
          "properties": {
            "source_entries": {"type": "integer", "minimum": 0},
            "derived_entries": {"type": "integer", "minimum": 0},
            "entries": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
