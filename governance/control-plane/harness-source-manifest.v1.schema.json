{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-mathing.local/schema/harness-source-manifest.v1.json",
  "title": "Web Problem Repository Harness Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "harness_version", "profile", "entries", "global_excludes", "excluded_container_skill_ids", "generated_files"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "pattern": "^harness-source:[a-z0-9][a-z0-9.-]*$"},
    "harness_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "profile": {"const": "web-research-full"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    },
    "global_excludes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "excluded_container_skill_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
    },
    "generated_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "target_path", "kind", "layer", "required", "owner", "privacy_class", "rewrite_policy"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "target_path": {"type": "string", "minLength": 1},
        "kind": {"enum": ["file", "tree"]},
        "layer": {"enum": ["research_core", "math_layer", "web_channel", "problem_instance"]},
        "required": {"type": "boolean"},
        "owner": {"enum": ["harness", "problem"]},
        "privacy_class": {"enum": ["public_code", "internal_code", "problem_data"]},
        "rewrite_policy": {"enum": ["replace_from_source", "generate_once", "never_replace"]},
        "license_ref": {"type": ["string", "null"], "minLength": 1},
        "excludes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
